# 把这个文件复制一份，改名为 .env，再填上下面的 API Key。
# .env 只留在你自己的电脑上，已被 .gitignore 忽略，不会被提交。

# 模型平台的 API Key，在 https://aihubmix.com 获取。
# 留空也能运行：系统会自动改用规则版本，并在页面右上角显示“降级·规则”。
AIHUBMIX_API_KEY=

# AI 模式：online（调用模型）/ offline（回放录制好的调用）/ degraded（只用规则，不调用模型）
APP_MODE=online
# 是否录制每次模型调用，录制后可以用 offline 模式回放
RECORD_CALLS=false

# 数据库连接串，留空就用本地 SQLite（data/app.db）
DATABASE_URL=

# 训练计时：把两步操作之间的真实思考时间计入停线时间（每步最多计多少秒）
COUNT_THINK_TIME=true
THINK_TIME_CAP_S=30
# 所有学员默认解锁全部关卡（不按段位限制）
DEMO_UNLOCK_ALL=false
